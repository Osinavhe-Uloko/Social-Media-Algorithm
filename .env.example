# Neon Postgres connection strings (Dashboard -> Connect -> Prisma tab gives
# you both). DATABASE_URL is the pooled connection used at runtime;
# DIRECT_URL is the unpooled one, used only for `prisma db push`/migrate.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

JWT_SECRET="change-this-to-a-long-random-string-in-production"
